{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/book.ts": {
      "includeFiles": "lib/*.js"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/(about|contact|privacy|terms)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
